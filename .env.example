# ============================================================
# TrustLens AI - Environment Configuration Example
# Copy this file to .env or backend/.env and populate as needed.
# No secrets or paid API keys are required for core features!
# ============================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./trustlens.db

# Passive Security & Network Safeguards
REQUEST_TIMEOUT_SECONDS=8
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60

# Optional External Threat Intelligence (Works without keys via public & heuristic fallbacks)
VIRUSTOTAL_API_KEY=
URLHAUS_API_ENABLED=true
PHISHTANK_API_ENABLED=true
OPENPHISH_API_ENABLED=true

# Optional AI / LLM Provider for Scam Message Analysis
# If left blank, TrustLens AI seamlessly operates using its deterministic security rule engine
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=deterministic # Options: deterministic, gemini, openai
