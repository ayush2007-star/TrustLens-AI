# ============================================================
# TrustLens AI - Environment Configuration Example
# Copy this file to .env or backend/.env and populate as needed.
# No secrets or paid API keys are required for core features!
# ============================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# In production, set a private random value of at least 32 characters.
# The same token gates API data access; it does not provide per-user accounts.
APP_ACCESS_TOKEN=

# Database
DATABASE_URL=sqlite:///./trustlens.db

# Passive Security & Network Safeguards
REQUEST_TIMEOUT_SECONDS=8
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=1048576

# Community report writes remain disabled unless deployment abuse controls are ready.
COMMUNITY_WRITES_ENABLED=false
COMMUNITY_ABUSE_KEY=

# Optional external threat intelligence
VIRUSTOTAL_API_KEY=
URLHAUS_API_ENABLED=true
